# Server
PORT=5000
NODE_ENV=development
DATA_STORE=local
SQLITE_PATH=./data/nischay.sqlite

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPEECH_LOCATION=global
GOOGLE_SPEECH_AUTO_LOCATION=us
BIGQUERY_DATASET=nischay_ai
BIGQUERY_TABLE=civic_requests
BIGQUERY_LOCATION=asia-south1

# Google Maps
# Browser key: restrict this key by HTTP referrer and Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
